# Copy this file to .env.local and fill in values as you complete later phases.
# Command: cp .env.example .env.local

# --- Phase 1: Supabase (database + auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 5: Stripe (use TEST keys until Stripe HK account is ready) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Phase 11: Email (Resend) ---
RESEND_API_KEY=

# --- Phase 4: Cron (auto-release expired slot locks on Vercel) ---
CRON_SECRET=generate-a-long-random-string-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
